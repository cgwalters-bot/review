{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional agent-board operator action v1 (agent-board#71 pending)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "why", "actions"],
  "properties": {
    "schema": { "const": "agent-board/operator-action/v1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]+$" },
    "why": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "actions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$" },
    "number": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "stamp": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" },
    "head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[^\\r\\n]+$" },
    "option": { "type": "string", "minLength": 1, "maxLength": 100 },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["repo", "number", "updatedAt"],
      "properties": { "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" } }
    },
    "action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "reason"],
          "properties": { "type": { "const": "close_issue" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "reason": { "type": "string", "minLength": 1, "maxLength": 4000 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt"],
          "properties": { "type": { "const": "reopen_issue" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "label"],
          "properties": { "type": { "enum": ["add_label", "remove_label"] }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "label": { "$ref": "#/$defs/label" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "head"],
          "properties": { "type": { "const": "approve_pr" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "head": { "$ref": "#/$defs/head" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "head", "method"],
          "properties": { "type": { "const": "merge_pr" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "head": { "$ref": "#/$defs/head" }, "method": { "enum": ["merge", "squash", "rebase"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "field", "from", "value"],
          "properties": { "type": { "const": "set_project_field" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "field": { "enum": ["Priority", "Status"] }, "from": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/option" }] }, "value": { "$ref": "#/$defs/option" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "parent", "previousParent"],
          "properties": { "type": { "const": "add_sub_issue" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "parent": { "$ref": "#/$defs/target" }, "previousParent": { "type": "null" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repo", "number", "updatedAt", "parent", "previousParent"],
          "properties": { "type": { "const": "move_sub_issue" }, "repo": { "$ref": "#/$defs/repo" }, "number": { "$ref": "#/$defs/number" }, "updatedAt": { "$ref": "#/$defs/stamp" }, "parent": { "$ref": "#/$defs/target" }, "previousParent": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*$" } }
        }
      ]
    }
  }
}
